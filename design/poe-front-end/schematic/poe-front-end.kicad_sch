  (label "CSS" (at 259.08 101.6 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 959cfa3a-36bb-592e-8783-0e9a8dbc7b2b))
  (text_box "R4 sets the class: 140 Ω for Class 1, 73.2 Ω for Class 2, 47.5 Ω for Class 3, 31.6 Ω for Class 4, and 35.7 Ω for Class 4 with the mark latch and the two-event detector fitted." (at 215.9 106.68 0) (size 50.8 12.7) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid b835a03e-650b-5d39-897f-4f340c960ff8))
  (rectangle (start 276.86 22.86) (end 396.24 127) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid ff900e1a-e774-5306-b319-67776b042309))
  (text "Hot swap" (at 279.4 25.4 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid 085aa450-8f70-5e2b-b0a5-f89d1f59a371))
  (text_box "Q13 connects the system ground GND to VSS once VDD has passed the voltage of D6 plus the gate threshold. C5 and C4 slow the turn-on so that the inrush current into C6 stays under the limit of the PSE. C6 is the input capacitor of the 5 V converter." (at 287.02 101.6 0) (size 101.6 8.89) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid c477bf54-70e9-5121-88e7-2626d04e4a23))

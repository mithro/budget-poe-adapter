  (text "LX-IS601F V2.0 switch board: reverse-engineered schematic" (at 25.4 25.4 0) (effects (font (size 3.5 3.5) bold) (justify left top)) (uuid 95e5fe8f-2019-5b78-985d-d048cf77950f))

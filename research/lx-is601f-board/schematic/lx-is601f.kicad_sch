  (text "LX-IS601F V2.0 switch board: reverse-engineered schematic" (at 25.4 25.4 0) (effects (font (size 3.5 3.5) bold) (justify left top)) (uuid 53340728-7115-5e21-9d43-f41e12f5806b))
  (text "Two boards photographed 2026-11-17. YT9215SCH 5-port GbE switch + SFP, with a 4-port PoE PSE plug-in module." (at 25.4 33.02 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid f88abc2c-aa20-5c0d-9b80-b272de24c489))
  (text "J2 input, protection,\nSCT2622 buck to +3V3" (at 33.02 60.96 0) (effects (font (size 1.27 1.27) italic (color 90 90 90 1)) (justify left top)) (uuid 1ca86274-5ebb-5659-a15f-b2ad9f29f2a3))
  (text "YT9215SCH (4 units),\n25 MHz crystal, EEPROM U10,\nempty flash footprint U6" (at 119.38 99.06 0) (effects (font (size 1.27 1.27) italic (color 90 90 90 1)) (justify left top)) (uuid 5cce762a-6cdb-52c4-a916-2d343f904661))

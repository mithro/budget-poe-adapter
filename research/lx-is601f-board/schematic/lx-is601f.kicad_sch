  (text "Two boards photographed 2026-11-17. YT9215SCH 5-port GbE switch + SFP, with a 4-port PoE PSE plug-in module." (at 15.24 22.86 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid eee6a1da-9716-4391-9a2f-81a60c568fe5))
  (text "+48V in -> +3V3 (SCT2622)\n+1V15 from U4 internal regulator" (at 20.32 71.12 0) (effects (font (size 1.5 1.5) italic) (justify left top)) (uuid 065f40ea-0166-4d48-ac8a-e67f1ab56aca))
  (text "J2 input, protection,\nSCT2622 buck to +3V3" (at 22.86 50.8 0) (effects (font (size 1.27 1.27) italic (color 90 90 90 1)) (justify left top)) (uuid 5ecb992c-b78c-4ff4-b1fe-37d70fc422b8))

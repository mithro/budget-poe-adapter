  (text "LX-IS601F V2.0 switch board: reverse-engineered schematic" (at 15.24 15.24 0) (effects (font (size 3.5 3.5) bold) (justify left top)) (uuid b1ae8d92-45db-4077-a946-57dc31e64f36))
  (text "Two boards photographed 2026-11-17. YT9215SCH 5-port GbE switch + SFP, with a 4-port PoE PSE plug-in module." (at 15.24 22.86 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid 659599a6-6612-4733-b554-2074a0089d79))
  (text "+48V in -> +3V3 (SCT2622)\n+1V15 from U4 internal regulator" (at 20.32 71.12 0) (effects (font (size 1.5 1.5) italic) (justify left top)) (uuid 3ff8e0e4-92ec-4d13-b2a2-823cfcaedf14))
  (text "J2 input, protection,\nSCT2622 buck to +3V3" (at 22.86 50.8 0) (effects (font (size 1.27 1.27) italic (color 90 90 90 1)) (justify left top)) (uuid 740616e3-bee4-4c7f-99ce-8b3b36720459))

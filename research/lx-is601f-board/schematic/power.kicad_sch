  (text "D1 and D5 sit next to the input; their nets are not traced." (at 25.4 99.06 0) (effects (font (size 1.27 1.27) italic) (justify left top)) (uuid b7e700bb-ae0e-5063-8f07-57d2a549d800))
  (text_box "Input\n- Assumed 48-57 V (C4 is rated 63 V). J2 polarity not checked.\n- RV1-RV3: blue disc parts, silk \"RV\". Drawn as varistors to GND;\n  they could be Y-capacitors to chassis.\n- L1 is a white SMD part (fuse or inductor).\n- D4 is assumed to be the reverse-polarity diode." (at 220.98 25.4 0) (size 93.98 15.24) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 2df323f3-6526-5b5a-b46c-340aad5a8f4f))
  (rectangle (start 22.86 114.3) (end 294.64 205.74) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid fdf075d6-d6a9-51a3-b415-c63a815afb81))
  (text "3.3 V buck: PU1 SCT2622 (4.2-60 V in, 2 A, non-synchronous)" (at 25.4 116.84 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid 64e85325-5f04-5c36-8cd9-280df43c2f19))

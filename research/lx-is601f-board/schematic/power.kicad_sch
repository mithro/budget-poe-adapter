  (text "D1 and D5 sit next to the input; their nets are not traced." (at 15.24 88.9 0) (effects (font (size 1.27 1.27) italic) (justify left top)) (uuid 8b1ad1ec-461e-4972-a1f6-1cada104b4a0))
  (text_box "Input\n- Assumed 48-57 V (C4 is rated 63 V). J2 polarity not checked.\n- RV1-RV3: blue disc parts, silk \"RV\". Drawn as varistors to GND;\n  they could be Y-capacitors to chassis.\n- L1 is a white SMD part (fuse or inductor).\n- D4 is assumed to be the reverse-polarity diode." (at 210.82 15.24 0) (size 93.98 30.48) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 8f715705-9228-4c8d-8a80-397565ae8172))
  (rectangle (start 10.16 104.14) (end 284.48 195.58) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid 56d43287-982f-4312-92ce-c44d8358dac7))
  (text "3.3 V buck: PU1 SCT2622 (4.2-60 V in, 2 A, non-synchronous)" (at 11.43 105.41 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid cae0f0bd-50db-4ca1-be7b-ec5376adcf9c))

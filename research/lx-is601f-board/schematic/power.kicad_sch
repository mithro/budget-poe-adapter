  (text "D1 and D5 sit next to the input; their nets are not traced." (at 15.24 88.9 0) (effects (font (size 1.27 1.27) italic) (justify left top)) (uuid 44ae3307-7d34-463e-8dfb-7dc9287efa6f))
  (text_box "Input\n- Assumed 48-57 V (C4 is rated 63 V). J2 polarity not checked.\n- RV1-RV3: blue disc parts, silk \"RV\". Drawn as varistors to GND;\n  they could be Y-capacitors to chassis.\n- L1 is a white SMD part (fuse or inductor).\n- D4 is assumed to be the reverse-polarity diode." (at 210.82 15.24 0) (size 93.98 30.48) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 5dc38262-9403-4119-b5bf-dfd0bbeba4b4))
  (rectangle (start 10.16 104.14) (end 284.48 195.58) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid f2e18e87-9248-46ad-940b-4a39dcce351b))
  (text "3.3 V buck: PU1 SCT2622 (4.2-60 V in, 2 A, non-synchronous)" (at 11.43 105.41 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid 69b84eb8-2533-4d58-93e0-9a5a542d58f6))

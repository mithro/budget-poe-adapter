  (text "D1 and D5 sit next to the input; their nets are not traced." (at 15.24 88.9 0) (effects (font (size 1.27 1.27) italic) (justify left top)) (uuid 5694f81d-588e-4c03-90c0-7e8aec458093))
  (text_box "Input\n- Assumed 48-57 V (C4 is rated 63 V). J2 polarity not checked.\n- RV1-RV3: blue disc parts, silk \"RV\". Drawn as varistors to GND;\n  they could be Y-capacitors to chassis.\n- L1 is a white SMD part (fuse or inductor).\n- D4 is assumed to be the reverse-polarity diode." (at 210.82 15.24 0) (size 93.98 15.24) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 9eed73e7-c7a0-45e8-ad76-f397bcf2c5ba))
  (rectangle (start 12.7 104.14) (end 284.48 195.58) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid 67a0c22a-3771-46be-a55b-a85649266dee))
  (text "3.3 V buck: PU1 SCT2622 (4.2-60 V in, 2 A, non-synchronous)" (at 15.24 106.68 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid 749ef348-6648-4611-b6b9-cd4a2dd6e41d))

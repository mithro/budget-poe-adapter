  (text "D1 and D5 sit next to the input; their nets are not traced." (at 25.4 96.52 0) (effects (font (size 1.27 1.27) italic) (justify left top)) (uuid 940affb6-875d-4ef7-837c-cc3355aa5af8))
  (text_box "Input\n- Assumed 48-57 V (C4 is rated 63 V). J2 polarity not checked.\n- RV1-RV3: blue disc parts, silk \"RV\". Drawn as varistors to GND;\n  they could be Y-capacitors to chassis.\n- L1 is a white SMD part (fuse or inductor).\n- D4 is assumed to be the reverse-polarity diode." (at 220.98 22.86 0) (size 93.98 15.24) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid f8d05d2c-e729-4926-bae1-cb8aae06ee10))
  (rectangle (start 22.86 111.76) (end 294.64 203.2) (stroke (width 0.254) (type dash) (color 110 110 110 1)) (fill (type none)) (uuid cefc0069-40da-47c0-b776-fa29c83a0d75))
  (text "3.3 V buck: PU1 SCT2622 (4.2-60 V in, 2 A, non-synchronous)" (at 25.4 114.3 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid f02cb41a-0309-49d6-a0fb-9c7e603b2a88))

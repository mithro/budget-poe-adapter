  (text_box "RBIAS: 2.49 kOhm 1 % to GND per datasheet. The\nresistor and the reset RC are not located." (at 25.4 109.22 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid c477bf54-70e9-5121-88e7-2626d04e4a23))
  (label "TBD_U10_WP" (at 81.28 162.56 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid d0a34408-ea5f-54fb-b45f-7cdef105b194))
  (text_box "U10 (bottom side). R14, R16, R19, R29, R30 and C15\nnext to it: probably pull-ups, WP and decoupling." (at 25.4 177.8 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid be2448a5-1844-5389-9490-45170f0eb9c0))

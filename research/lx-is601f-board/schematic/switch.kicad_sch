  (text_box "Port mapping (inferred from placement)\nP0 -> DXFRM4 -> J1 port 1\nP1 -> DXFRM3 -> J1 port 2\nP2 -> DXFRM2 -> J1 port 3\nP3 -> DXFRM5 -> J1 port 4\nP4 -> DXFRM6 -> J3 uplink\nMDIn: 0..7 = A+ A- B+ B- C+ C- D+ D-" (at 294.64 200.66 0) (size 60.96 30.48) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid d4a39d73-10e2-407c-8eb2-10c7d11d640a))

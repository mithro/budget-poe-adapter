  (text "U4D: supply pins" (at 290.83 280.67 0) (effects (font (size 2 2) bold (color 0 0 132 1)) (justify left top)) (uuid 18126774-2c22-403b-9335-aaddd02bd043))
  (text_box "Supplies (datasheet): AVDDH, DVDDIO, SVDDH, HV_SWR = 3.3 V;\nAVDDL, DVDDL, SVDDL, PLLVDDL = 1.15 V (1.08-1.32 V).\n\nAbout 30 0402 decoupling capacitors surround U4 (C19, C21,\nC22, C25, C26, C30, C45, C48, C49, C92-C97, C100, C105,\nC111-C113, C119, C122-C126, ...). Their rails are not traced,\nso they are not drawn.\n\nEPAD (pin 129) is GND; a screw through the board clamps the\nheatsink onto it." (at 414.02 284.48 0) (size 78.74 48.26) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 333eee74-61a0-4d59-ac22-374b6829bf63))

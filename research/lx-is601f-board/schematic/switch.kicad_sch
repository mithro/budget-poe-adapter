  (text_box "U10 (bottom side). R14, R16, R19, R29, R30 and C15\nnext to it: probably pull-ups, WP and decoupling." (at 25.4 175.26 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid c05cee5a-00aa-4ca2-98ac-dc5e179a7063))

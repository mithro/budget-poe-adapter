  (text_box "U6: empty SOP-8 footprint on the bottom, assumed SPI NOR\nflash (25-series pinout). R40, R94, R96, R98, R100, R102,\nR109 sit next to it. R44/R89/R92/R93 to U4 pins 55/54/50/49\nare seen on the top side." (at 15.24 231.14 0) (size 71.12 15.24) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid eaa48a75-a207-483d-b634-0c72855c5e71))

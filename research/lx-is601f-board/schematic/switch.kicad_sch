  (text_box "Which SerDes feeds the SFP (U12) is not traced;\nSerDes 0 is assumed. SerDes 1 nets end here." (at 464.82 83.82 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid ab3abb30-989c-47fc-a15b-a1d63a29e11a))

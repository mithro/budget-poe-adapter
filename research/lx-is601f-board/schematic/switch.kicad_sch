  (text_box "RBIAS: 2.49 kOhm 1 % to GND per datasheet. The\nresistor and the reset RC are not located yet." (at 15.24 99.06 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 82805812-8a40-4fc0-9410-5715b212ad31))

  (text_box "U10 (bottom side). R14, R16, R19, R29, R30 and C15\nnext to it: probably pull-ups, WP and decoupling." (at 15.24 167.64 0) (size 60.96 10.16) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid ab69c963-1440-4b14-8f37-b588330fc323))

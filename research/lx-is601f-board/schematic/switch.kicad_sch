  (text_box "Which SerDes feeds the SFP (U12) is not traced;\nSerDes 0 is assumed. SerDes 1 nets end here." (at 474.98 91.44 0) (size 60.96 6.35) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid cfd118c4-1aab-4387-8a93-d3f1d853b5b5))

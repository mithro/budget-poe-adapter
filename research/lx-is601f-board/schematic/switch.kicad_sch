  (text_box "U6: empty SOP-8 footprint on the bottom, assumed SPI NOR\nflash (25-series pinout). R40, R94, R96, R98, R100, R102,\nR109 sit next to it. R44, R89, R92 and R93 run to U4 pins\n55, 54, 50 and 49 on the top side." (at 25.4 248.92 0) (size 71.12 11.43) (stroke (width 0.1524) (type solid) (color 120 120 120 1)) (fill (type color) (color 255 255 225 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 5e557e33-12b6-5832-8d92-507c5accd547))

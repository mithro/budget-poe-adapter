/* SPDX-License-Identifier: Apache-2.0 */
/*
 * A bit-banged MDIO bus on two emulated GPIOs, with the switch at MDIO
 * address 0x1d. On real hardware, put the switch node under the MDIO
 * controller of the board in the same way.
 */
/ {
	mdio0: mdio {
		compatible = "zephyr,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		mdc-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;

		switch0: switch@1d {
			compatible = "motorcomm,yt921x";
			reg = <0x1d>;
		};
	};
};

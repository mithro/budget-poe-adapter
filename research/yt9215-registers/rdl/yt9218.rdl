        field { desc = "Which entries GET_NEXT walks."; sw = rw; hw = r; encode = fdb_op_next_type_e; } NEXT_TYPE[5:4];
        field { desc = "Command."; sw = rw; hw = r; encode = fdb_op_op_e; } OP[3:1];
        field { desc = "Write 1 to start the command."; sw = rw; hw = r; } START[0:0];
    } FDB_OP @ 0x180460;


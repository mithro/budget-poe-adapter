        field { desc = "Slot bin is in use."; sw = rw; hw = r; } EN_0[0:0];
    } ACL_ENTRY[48] @ 0x203000 += 0x4;

    regfile {
        name = "ACL key slot, one value of index bin";
        reg {
            name = "ACL key slot";
            desc = "Value half of one key slot. Index blk is the block and bin the slot in the block. The layout of bits 35 to 0 and of the range flags depends on ACL_KEY.TYPE. Index: blk = 0 to 47, bin = 0 to 7.";
            regwidth = 64;
            enum acl_key_type_e {
                NA = 0 { desc = "Slot not used"; };
                MAC_DA0 = 1 { desc = "Destination MAC address bits 47 to 16"; };
                MAC_SA0 = 2 { desc = "Source MAC address bits 47 to 16"; };
                MAC_DA1_SA1 = 3 { desc = "Destination and source MAC address bits 15 to 0"; };
                VLAN = 4 { desc = "VLAN identifiers and priorities with tag format"; };
                VTAG = 5 { desc = "VLAN identifiers and priorities"; };
                IPV4_DA = 6 { desc = "IPv4 destination address"; };
                IPV4_SA = 7 { desc = "IPv4 source address"; };
                IPV6_DA0 = 8 { desc = "IPv6 destination address bits 127 to 96"; };
                IPV6_DA1 = 9 { desc = "IPv6 destination address bits 95 to 64"; };
                IPV6_DA2 = 10 { desc = "IPv6 destination address bits 63 to 32"; };
                IPV6_DA3 = 11 { desc = "IPv6 destination address bits 31 to 0"; };
                IPV6_SA0 = 12 { desc = "IPv6 source address bits 127 to 96"; };
                IPV6_SA1 = 13 { desc = "IPv6 source address bits 95 to 64"; };
                IPV6_SA2 = 14 { desc = "IPv6 source address bits 63 to 32"; };
                IPV6_SA3 = 15 { desc = "IPv6 source address bits 31 to 0"; };
                MISC = 16 { desc = "IP and TCP header fields. The fields are the IP protocol and the type of service and the TCP flags and the frame class"; };
                L4 = 17 { desc = "TCP or UDP source and destination ports"; };
                UDF0 = 18 { desc = "User-defined field windows 0 and 1"; };
                UDF1 = 19 { desc = "User-defined field windows 2 and 3"; };
                UDF2 = 20 { desc = "User-defined field windows 4 and 5"; };
                UDF3 = 21 { desc = "User-defined field windows 6 and 7"; };
                UDF4 = 22 { desc = "User-defined field windows 8 and 9"; };
                UDF5 = 23 { desc = "User-defined field windows 10 and 11"; };
                UDF6 = 24 { desc = "User-defined field windows 12 and 13"; };
                UDF7 = 25 { desc = "User-defined field windows 14 and 15"; };
                ETHERTYPE = 26 { desc = "EtherType"; };
            };
            field { desc = "Order of the rule. When several rules match, the highest value wins."; sw = rw; hw = r; } ORD[61:53];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_10[52:52];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_9[51:51];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_8[50:50];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_7[49:49];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_6[48:48];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_5[47:47];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_4[46:46];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_3[45:45];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_2[44:44];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_1[43:43];
            field { desc = "Receiving ports the rule applies to. Each port has one bit."; sw = rw; hw = r; } SPORTS_0[42:42];
            field { desc = "The slot matches when the frame does not match the key."; sw = rw; hw = r; } REVERSE[41:41];
            field { desc = "Key type. It selects the layout of the rest of the slot."; sw = rw; hw = r; encode = acl_key_type_e; } TYPE[40:36];
            field { desc = "Meaning depends on the key type; see the ACL key layouts in the documentation."; sw = rw; hw = r; } LAYOUT_62[63:62];
            field { desc = "Meaning depends on the key type; see the ACL key layouts in the documentation."; sw = rw; hw = r; } LAYOUT_0[35:0];
        } BLK[48] @ 0x0 += 0x8;
    } ACL_KEY[8] @ 0x204000 += 0x200;

    regfile {
        name = "ACL mask slot, one value of index bin";
        reg {
            name = "ACL mask slot";
            desc = "Mask half of one key slot. A set bit means the same bit of ACL_KEY must match; the layouts are those of the key. For a field matched as a range the mask holds the highest value. Index: blk = 0 to 47, bin = 0 to 7.";
            regwidth = 64;
            field { desc = "Meaning depends on the key type; see the ACL key layouts in the documentation."; sw = rw; hw = r; } LAYOUT_0[35:0];
        } BLK[48] @ 0x0 += 0x8;
    } ACL_MASK[8] @ 0x205000 += 0x200;

    reg {
        name = "Ingress tag protocol identifiers";
        desc = "Four tag protocol identifier values the parser can recognise as a VLAN tag. PORT_IGR_TPID chooses which of them each port accepts. Index: n = 0 to 3.";
        field { desc = "Tag protocol identifier. An example is 0x8100."; sw = rw; hw = r; } TPID[15:0];
    } TPID_IGR[4] @ 0x210000 += 0x4;

    reg {
        name = "Port ingress tag recognition";
        desc = "Chooses which TPID_IGR entries one port treats as a customer tag and which as a service tag. VLAN-aware and VLAN-unaware ports shows how this makes a port ignore VLAN tags. Index: port = 0 to 10.";
        field { desc = "Entry n of TPID_IGR marks a service tag on this port."; sw = rw; hw = r; } STAG_3[7:7];
        field { desc = "Entry n of TPID_IGR marks a service tag on this port."; sw = rw; hw = r; } STAG_2[6:6];
        field { desc = "Entry n of TPID_IGR marks a service tag on this port."; sw = rw; hw = r; } STAG_1[5:5];
        field { desc = "Entry n of TPID_IGR marks a service tag on this port."; sw = rw; hw = r; } STAG_0[4:4];
        field { desc = "Entry n of TPID_IGR marks a customer tag on this port."; sw = rw; hw = r; } CTAG_3[3:3];
        field { desc = "Entry n of TPID_IGR marks a customer tag on this port."; sw = rw; hw = r; } CTAG_2[2:2];
        field { desc = "Entry n of TPID_IGR marks a customer tag on this port."; sw = rw; hw = r; } CTAG_1[1:1];
        field { desc = "Entry n of TPID_IGR marks a customer tag on this port."; sw = rw; hw = r; } CTAG_0[0:0];
    } PORT_IGR_TPID[11] @ 0x210010 += 0x4;

    reg {
        name = "Link aggregation hash inputs";
        desc = "Frame fields that feed the hash which spreads traffic over the members of a group.";
        field { desc = "Include the layer 4 source port."; sw = rw; hw = r; } L4_SPORT[7:7];
        field { desc = "Include the layer 4 destination port."; sw = rw; hw = r; } L4_DPORT[6:6];
        field { desc = "Include the IP protocol number."; sw = rw; hw = r; } IP_PROTO[5:5];
        field { desc = "Include the IP source address."; sw = rw; hw = r; } IP_SRC[4:4];
        field { desc = "Include the IP destination address."; sw = rw; hw = r; } IP_DST[3:3];
        field { desc = "Include the source MAC address."; sw = rw; hw = r; } MAC_SA[2:2];
        field { desc = "Include the destination MAC address."; sw = rw; hw = r; } MAC_DA[1:1];
        field { desc = "Include the receiving port."; sw = rw; hw = r; } SRC_PORT[0:0];
    } LAG_HASH @ 0x210090;

    reg {
        name = "User-defined field window";
        desc = "Position of one two-byte window that ACL keys of type UDF can match. Key type UDFk matches windows 2k and 2k + 1. Index: n = 0 to 15.";
        enum udf_ctrl_udf_type_e {
            L2 = 0 { desc = "Start of the Ethernet header"; };
            L3 = 1 { desc = "Start of the layer 3 header"; };
            L4 = 2 { desc = "Start of the layer 4 header"; };
        };
        field { desc = "Header the offset is counted from."; sw = rw; hw = r; encode = udf_ctrl_udf_type_e; } UDF_TYPE[8:7];
        field { desc = "Offset in bytes of the two-byte window from the start of that header."; sw = rw; hw = r; } UDF_OFFSET[6:0];
    } UDF_CTRL[16] @ 0x210094 += 0x4;

    reg {
        name = "Port rate accounting";
        desc = "Per-frame overhead that rate limiting adds to the frame length. Index: port = 0 to 10.";
        field { desc = "Bytes added per frame for preamble and inter-frame gap. A meter adds them when BYTE_MODE_INCLUDE_GAP is set."; sw = rw; hw = r; } GAP_VALUE[4:0];
    } PORT_RATE[11] @ 0x220000 += 0x4;

    reg {
        name = "Meter time slot";
        desc = "Period at which every meter adds tokens to its buckets.";
        field { desc = "Slot length in units of eight core clock periods. SYS_CLK shows the core clock. The smallest allowed value is 80."; sw = rw; hw = r; } SLOT[11:0];
    } METER_SLOT @ 0x220104;

    reg {
        name = "Port ingress meter";
        desc = "Attaches one of the per-port meters to the receive side of a port. Index: port = 0 to 10.";
        field { desc = "Enables ingress rate limiting on the port."; sw = rw; hw = r; } EN[4:4];
        field { desc = "Port meter number n. The meter is entry 64 + n of METER_CTRL."; sw = rw; hw = r; } ID[3:0];
    } PORT_METER[11] @ 0x220108 += 0x4;

    reg {
        name = "Meter configuration";
        desc = "96-bit configuration of one two-rate token bucket meter. Entries 0 to 63 are general-purpose meters for ACL rules; entries 64 to 74 are the per-port meters. Token arithmetic gives the conversion from bit rates. Index: meter = 0 to 74.";
        regwidth = 128;
        enum meter_ctrl_drop_e {
            GYR = 0 { desc = "Drop every frame"; };
            YR = 1 { desc = "Drop yellow and red frames"; };
            R = 2 { desc = "Drop red frames"; };
            NONE = 3 { desc = "Drop nothing and only colour the frame"; };
        };
        field { desc = "Enables the meter."; sw = rw; hw = r; } METER_EN[78:78];
        field { desc = "Tokens that overflow the committed bucket spill into the excess bucket. The comment on the field reads \"RFC4115: yellow use unused green bw\"."; sw = rw; hw = r; } TOKEN_OVERFLOW_EN[77:77];
        field { desc = "Colours that are dropped."; sw = rw; hw = r; encode = meter_ctrl_drop_e; } DROP[76:75];
        field { desc = "Ignore the colour the frame already has."; sw = rw; hw = r; } COLOR_BLIND[74:74];
        field { desc = "Token scale. Every token value is multiplied by 4 to the power of UNIT."; sw = rw; hw = r; } UNIT[73:71];
        field { desc = "Add PORT_RATE.GAP_VALUE bytes to each frame in byte mode."; sw = rw; hw = r; } BYTE_MODE_INCLUDE_GAP[70:70];
        field { desc = "Meter packets. Value 0 meters bytes."; sw = rw; hw = r; } PKT_MODE[69:69];
        field { desc = "Select the algorithm of RFC 2698. Value 0 selects that of RFC 4115."; sw = rw; hw = r; } RFC2698[68:68];
        field { desc = "Committed burst size in tokens. The field crosses the boundary between words 1 and 2."; sw = rw; hw = r; } CBS[67:52];
        field { desc = "Committed information rate in tokens per time slot."; sw = rw; hw = r; } CIR[51:34];
        field { desc = "Excess burst size in tokens. The field crosses the boundary between words 0 and 1."; sw = rw; hw = r; } EBS[33:18];
        field { desc = "Excess information rate in tokens per time slot."; sw = rw; hw = r; } EIR[17:0];
    } METER_CTRL[75] @ 0x220800 += 0x10;

    reg {
        name = "Meter token state";
        desc = "Current token counts of one meter. The bit layout is not known. Index: meter = 0 to 74.";
        regwidth = 64;
        field { desc = "Layout not known."; sw = r; hw = w; } VALUE[63:0];
    } METER_STAT[75] @ 0x221000 += 0x8;

    reg {
        name = "Port default VLAN";
        desc = "VLAN IDs and priorities given to frames that arrive on a port without the matching tag. Index: port = 0 to 10.";
        field { desc = "Use SVLAN_PRIO as the default service tag priority."; sw = rw; hw = r; } SVLAN_PRIO_EN[31:31];
        field { desc = "Use CVLAN_PRIO as the default customer tag priority."; sw = rw; hw = r; } CVLAN_PRIO_EN[30:30];
        field { desc = "Default service VLAN ID."; sw = rw; hw = r; } SVID[29:18];
        field { desc = "Default customer VLAN ID (the port VLAN ID)."; sw = rw; hw = r; } CVID[17:6];
        field { desc = "Default service tag priority."; sw = rw; hw = r; } SVLAN_PRIO[5:3];
        field { desc = "Default customer tag priority."; sw = rw; hw = r; } CVLAN_PRIO[2:0];
    } PORT_VLAN_CTRL[11] @ 0x230010 += 0x4;

    reg {
        name = "Port acceptable frame types";
        desc = "Drops tagged or untagged frames on receive, per tag kind. Index: port = 0 to 10.";
        field { desc = "Enables VLAN range matching with the profile in VLAN_RANGE_PROFILE_ID."; sw = rw; hw = r; } VLAN_RANGE_EN[8:8];
        field { desc = "VLAN range profile number."; sw = rw; hw = r; } VLAN_RANGE_PROFILE_ID[7:4];
        field { desc = "Drop received frames that carry a service tag."; sw = rw; hw = r; } SVLAN_DROP_TAGGED[3:3];
        field { desc = "Drop received frames that carry no service tag."; sw = rw; hw = r; } SVLAN_DROP_UNTAGGED[2:2];
        field { desc = "Drop received frames that carry a customer tag."; sw = rw; hw = r; } CVLAN_DROP_TAGGED[1:1];
        field { desc = "Drop received frames that carry no customer tag."; sw = rw; hw = r; } CVLAN_DROP_UNTAGGED[0:0];
    } PORT_VLAN_CTRL1[11] @ 0x230080 += 0x4;

    reg {
        name = "Port mirroring";
        desc = "Source ports and the single monitor port of port mirroring.";
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_10[26:26];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_9[25:25];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_8[24:24];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_7[23:23];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_6[22:22];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_5[21:21];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_4[20:20];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_3[19:19];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_2[18:18];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_1[17:17];
        field { desc = "Ports whose received frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } IGR_PORTS_0[16:16];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_10[14:14];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_9[13:13];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_8[12:12];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_7[11:11];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_6[10:10];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_5[9:9];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_4[8:8];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_3[7:7];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_2[6:6];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_1[5:5];
        field { desc = "Ports whose sent frames are copied to the monitor port. Each port has one bit."; sw = rw; hw = r; } EGR_PORTS_0[4:4];
        field { desc = "Monitor port number."; sw = rw; hw = r; } PORT[3:0];
    } MIRROR @ 0x300300;

    reg {
        name = "Shaper time slot";
        desc = "Period at which every port shaper adds tokens to its bucket.";
        field { desc = "Slot length in units of eight core clock periods. SYS_CLK shows the core clock. The smallest allowed value is 80."; sw = rw; hw = r; } SLOT[11:0];
    } PORT_SHAPE_SLOT @ 0x34000C;

    reg {
        name = "Port egress shaper";
        desc = "64-bit configuration of the single token bucket that limits what one port sends. Token arithmetic gives the conversion from bit rates. Index: port = 0 to 10.";
        regwidth = 64;
        field { desc = "Enables the shaper."; sw = rw; hw = r; } EN[36:36];
        field { desc = "Shape packets. Value 0 shapes bytes."; sw = rw; hw = r; } PKT_MODE[35:35];
        field { desc = "Token scale. Every token value is multiplied by 4 to the power of UNIT."; sw = rw; hw = r; } UNIT[34:32];
        field { desc = "Burst size in tokens."; sw = rw; hw = r; } CBS[31:18];
        field { desc = "Rate in tokens per time slot."; sw = rw; hw = r; } CIR[17:0];
    } PORT_SHAPE_CTRL[11] @ 0x354000 += 0x8;

    reg {
        name = "Port shaper token state";

        field { desc = "Block number from 0 to 47."; sw = rw; hw = r; } BLKID[6:1];
        field { desc = "Write 1 to open the block for writing. Write 0 to commit the changes."; sw = rw; hw = r; } MODIFY[0:0];
    } ACL_BLK_CMD @ 0x202004;

    reg {
        name = "ACL block slot enables";
        desc = "Enables the eight key slots of one block and groups slots into rules. Slots with the same group number must all match for the rule to hit; the group number is also the slot whose ACL_ACT entry holds the action. Index: blk = 0 to 47.";
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_7[31:29];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_6[27:25];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_5[23:21];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_4[19:17];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_3[15:13];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_2[11:9];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_1[7:5];
        field { desc = "Group number of slot bin. The slots of one rule share a group number."; sw = rw; hw = r; } GRPID_0[3:1];
        field { desc = "Slot bin is in use."; sw = rw; hw = r; } EN_7[28:28];

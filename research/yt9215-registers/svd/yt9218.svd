    <peripheral>
      <name>EDATA</name>
      <description>Configuration byte store and clock</description>
      <baseAddress>0x000E0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x44</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>EDATA_CTRL</name>
          <description>Command register of the configuration byte store of 256 bytes. Writing it starts the command; Identify the part shows the read sequence.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OP</name>
              <description>Command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>READ</name>
                  <description>Read the byte at ADDR into EDATA_DATA.DATA</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADDR</name>
              <description>Byte address from 0 to 255.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EDATA_DATA</name>
          <description>Result and state of the last EDATA_CTRL command.</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>STATUS</name>
              <description>State of the store.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>No command is running. DATA is valid</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DATA</name>
              <description>Byte that was read.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SYS_CLK</name>
          <description>Shows which core clock the switch runs from. yt921x_chip_detect reads it. The time slots of METER_SLOT and PORT_SHAPE_SLOT count in units of eight core clock periods.</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SEL</name>
              <description>Core clock in use. Value 0 stands for 125 MHz in the YT9215 family and 167 MHz in the YT9218 family. The core clock table lists the clock periods.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V167M</name>
                  <description>167 MHz core clock</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V143M</name>
                  <description>143 MHz core clock</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>INT_MBUS</name>
      <description>Internal MDIO master</description>
      <baseAddress>0x000F0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>INT_MBUS_OP</name>
          <description>Starts a transfer on the internal MDIO master and shows when it has finished; see MDIO master transfer.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>START</name>
              <description>Write 1 to start the transfer set up in INT_MBUS_CTRL. Reads 1 until the transfer is complete.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_MBUS_CTRL</name>
          <description>Address and direction of the next transfer to a built-in PHY or SerDes PCS.</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>OP</name>
              <description>Direction. The comment on the field reads "wild guess", so the width of the field is inferred.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WRITE</name>
                  <description>Write the register</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ</name>
                  <description>Read the register</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TYPE</name>
              <description>Frame format. The comment on the field reads "wild guess", so the width of the field is inferred.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>C22</name>
                  <description>IEEE 802.3 clause 22 frame</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REG</name>
              <description>PHY register number from 0 to 31.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PORT</name>
              <description>PHY address from 0 to 31. On the internal bus it equals the port number.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_MBUS_DOUT</name>
          <description>Data for the next write transfer on the internal MDIO master.</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>The 16-bit PHY register value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_MBUS_DIN</name>
          <description>Data returned by the last read transfer on the internal MDIO master.</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>The 16-bit PHY register value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EGRESS</name>
      <description>Egress tag processing</description>
      <baseAddress>0x00100000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x310</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_EGR[%s]</name>
          <description>Chooses which TPID_EGR entry a port writes into the VLAN tags it adds on transmit. Index: port = 0 to 10.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TPID_STAG</name>
              <description>Index of the TPID_EGR entry used for service tags.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TPID_CTAG</name>
              <description>Index of the TPID_EGR entry used for customer tags.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>TPID_EGR[%s]</name>
          <description>Four tag protocol identifier values a port can write into transmitted VLAN tags. Index: n = 0 to 3.</description>
          <addressOffset>0x300</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TPID</name>
              <description>Tag protocol identifier. An example is 0x8100.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>L2</name>
      <description>Layer 2 forwarding and VLAN table</description>
      <baseAddress>0x00180000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>64</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IPM_DSCP[%s]</name>
          <description>Internal priority and colour for each of the 64 IP DSCP values. Index: dscp = 0 to 63.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COLOR</name>
              <description>Drop precedence colour. It is inferred from METER_CTRL.COLOR_BLIND that the meters use it.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GREEN</name>
                  <description>Lowest drop precedence</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>YELLOW</name>
                  <description>Yellow</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RED</name>
                  <description>Highest drop precedence</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRIO</name>
              <description>Internal priority from 0 to 7.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>32</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>IPM_PCP[%s]</name>
          <description>Internal priority and colour for each VLAN tag priority. There are two maps (index map); each has one entry per drop eligible bit value (dei) and priority code point (pcp). PORT_QOS picks the map a port uses. Index: map = 0 to 1, dei = 0 to 1, pcp = 0 to 7. Flat index = 16 × map + 8 × dei + pcp.</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>COLOR</name>
              <description>Drop precedence colour. It is inferred from METER_CTRL.COLOR_BLIND that the meters use it.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GREEN</name>
                  <description>Lowest drop precedence</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>YELLOW</name>
                  <description>Yellow</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RED</name>
                  <description>Highest drop precedence</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRIO</name>
              <description>Internal priority from 0 to 7.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_QOS[%s]</name>
          <description>Port default priority and the choice of IPM_PCP map. Index: port = 0 to 10.</description>
          <addressOffset>0x180</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PRIO_EN</name>
              <description>Enables the port default priority.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRIO</name>
              <description>Port default priority from 0 to 7.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVLAN_PRIO_MAP_ID</name>
              <description>Index map of the IPM_PCP map used for service tags.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CVLAN_PRIO_MAP_ID</name>
              <description>Index map of the IPM_PCP map used for customer tags.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_PRIO_ORD[%s]</name>
          <description>Ranks the sources of a frame's internal priority on one port. Each source has a 3-bit weight; the source with the highest non-zero weight that applies to the frame wins. Priority sources lists the source numbers. Index: port = 0 to 10.</description>
          <addressOffset>0x200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>3</dimIncrement>
              <dimIndex>0-7</dimIndex>
              <name>APP%s</name>
              <description>Weight of priority source app. 0 disables the source, except for the port default priority which is enabled by PORT_QOS.PRIO_EN.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>VLAN_IGR_FILTER</name>
          <description>Per-port ingress VLAN membership check.</description>
          <addressOffset>0x280</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORT%s</name>
              <description>Port port receives frames only of VLANs that list it.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORT_BYPASS_IGMP%s</name>
              <description>IGMP frames received on port port skip the ingress membership check.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_ISOLATION[%s]</name>
          <description>Destination ports that frames received on one port must not be sent to. This is the mechanism that separates ports into groups; see Port isolation. Index: port = 0 to 10.</description>
          <addressOffset>0x294</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>BLOCK%s</name>
              <description>Frames received on this port are never sent to port port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>STP[%s]</name>
          <description>Port states of one spanning tree instance, two bits per port. A VLAN chooses its instance with VLAN_CTRL.STP_ID. Index: inst = 0 to 15.</description>
          <addressOffset>0x38C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>2</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORT%s</name>
              <description>State of port port in this instance.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Port neither forwards nor learns</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LEARNING</name>
                  <description>Port learns addresses but does not forward</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BLOCKING</name>
                  <description>Port neither forwards nor learns. It is inferred from IEEE 802.1D that the port receives bridge protocol frames</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORWARD</name>
                  <description>Port forwards and learns</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_LEARN[%s]</name>
          <description>Controls learning of source addresses on one port. Index: port = 0 to 10.</description>
          <addressOffset>0x3D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MODE</name>
              <description>Who learns addresses.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AUTO</name>
                  <description>The switch learns by itself</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTO_AND_COPY</name>
                  <description>The switch learns and copies the frame to the CPU</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CPU_CONTROL</name>
                  <description>Only the CPU adds entries</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DROP_ON_EXCEEDED</name>
              <description>Drop frames with a new source address once the limit is reached.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LIMIT</name>
              <description>Largest number of addresses learned on the port. The vendor SDK lists this field as 13 bits wide, at bits 15 to 3.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LIMIT_EN</name>
              <description>Enables the limit in LIMIT.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIS</name>
              <description>Disables address learning on the port.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SUSPEND_DROP_EN</name>
              <description>Drop frames with a not yet learned source address.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SUSPEND_COPY_EN</name>
              <description>Copy frames with a not yet learned source address to the CPU.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VID_LEARN_EN</name>
              <description>Function not known.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VID_LEARN_MODE</name>
              <description>Function not known.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VID_LEARN_MULTI_EN</name>
              <description>Function not known.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AGEING</name>
          <description>Time base of forwarding database ageing.</description>
          <addressOffset>0x440</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INTERVAL</name>
              <description>Ageing time in units of 5 seconds.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_IN0</name>
          <description>First input word of a forwarding database command; see Forwarding database.</description>
          <addressOffset>0x454</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDR_HI4</name>
              <description>MAC address bytes 0 to 3. Byte 0 is in bits 31 to 24.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_IN1</name>
          <description>Second input word of a forwarding database command.</description>
          <addressOffset>0x458</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ADDR_LO2</name>
              <description>MAC address bytes 4 and 5. Byte 4 is in bits 15 to 8.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FID</name>
              <description>Filtering ID of the entry. The Linux driver uses the VLAN ID as the filtering ID.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STATUS</name>
              <description>State of the entry.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INVALID</name>
                  <description>Entry is empty</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MIN_TIME</name>
                  <description>Dynamic entry about to age out</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOVE_AGING_MAX_TIME</name>
                  <description>Dynamic entry that moved to another port</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MAX_TIME</name>
                  <description>Dynamic entry just learned or refreshed</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PENDING</name>
                  <description>Entry waiting for the CPU to confirm it</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STATIC</name>
                  <description>Static entry that never ages out</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EGR_PRIO_EN</name>
              <description>Apply PRIO to frames sent to this address.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_IN2</name>
          <description>Third input word of a forwarding database command.</description>
          <addressOffset>0x45C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>NEW_VID</name>
              <description>Replacement VLAN ID for frames matching the entry.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRIO</name>
              <description>Priority given by this entry. It is a source for PORT_PRIO_ORD.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IGR_PRIO_EN</name>
              <description>Apply PRIO to frames received from this address.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>COPY_TO_CPU</name>
              <description>Also copy frames to this address to the CPU.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EGR_DROP</name>
              <description>Drop frames sent to this address.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EGR_PORTS</name>
              <description>Ports that frames to this address are sent to. Each port has one bit.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IGR_DROP</name>
              <description>Drop frames received from this address.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MOVE_AGING_STATUS</name>
              <description>Ageing state of an entry that moved between ports.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_OP</name>
          <description>Selects and starts a forwarding database command. Write the input words first, then this register with START set, then wait for FDB_RESULT.DONE.</description>
          <addressOffset>0x460</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>START</name>
              <description>Write 1 to start the command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OP</name>
              <description>Command.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ADD</name>
                  <description>Write an entry</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEL</name>
                  <description>Delete an entry</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GET_ONE</name>
                  <description>Read one entry</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GET_NEXT</name>
                  <description>Read the next used entry after INDEX</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FLUSH</name>
                  <description>Delete many entries</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEXT_TYPE</name>
              <description>Which entries GET_NEXT walks.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UCAST_PORT</name>
                  <description>Unicast entries of one port</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UCAST_VID</name>
                  <description>Unicast entries of one filtering ID</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UCAST</name>
                  <description>All unicast entries</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MCAST</name>
                  <description>Multicast entries</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLUSH_STATIC</name>
              <description>A flush also removes static entries.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLUSH</name>
              <description>Scope of a flush.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ALL</name>
                  <description>Every entry of the kind that FDB_OP.FLUSH_MCAST selects</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORT</name>
                  <description>Entries of the ports in FDB_IN2.EGR_PORTS</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORT_VID</name>
                  <description>Entries of the ports in FDB_IN2.EGR_PORTS with the filtering ID in FDB_IN1.FID</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VID</name>
                  <description>Entries with the filtering ID in FDB_IN1.FID</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLUSH_MCAST</name>
              <description>A flush removes multicast entries in place of unicast entries. The vendor SDK list yt_l2_tbl_op_flush_mode_t gives this meaning to the bit.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE_INDEX</name>
              <description>Addresses the entry by INDEX. Value 0 addresses it by MAC address and filtering ID.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INDEX</name>
              <description>Entry index from 0 to 4095. It is used when MODE_INDEX is set.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_RESULT</name>
          <description>Completion flag and outcome of the last FDB_OP command.</description>
          <addressOffset>0x464</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>INDEX</name>
              <description>Index of the entry the command acted on.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERWRITED</name>
              <description>The command overwrote an existing entry.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NOTFOUND</name>
              <description>No entry matched.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DONE</name>
              <description>1 when the command has finished.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_OUT0</name>
          <description>First word of the entry read by a FDB_OP.OP.GET_ONE or FDB_OP.OP.GET_NEXT command.</description>
          <addressOffset>0x4B0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADDR_HI4</name>
              <description>MAC address bytes 0 to 3. Byte 0 is in bits 31 to 24.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_OUT1</name>
          <description>Second word of the entry read by a FDB_OP.OP.GET_ONE or FDB_OP.OP.GET_NEXT command.</description>
          <addressOffset>0x4B4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>ADDR_LO2</name>
              <description>MAC address bytes 4 and 5. Byte 4 is in bits 15 to 8.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FID</name>
              <description>Filtering ID of the entry. The Linux driver uses the VLAN ID as the filtering ID.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>STATUS</name>
              <description>State of the entry.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INVALID</name>
                  <description>Entry is empty</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MIN_TIME</name>
                  <description>Dynamic entry about to age out</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOVE_AGING_MAX_TIME</name>
                  <description>Dynamic entry that moved to another port</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MAX_TIME</name>
                  <description>Dynamic entry just learned or refreshed</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PENDING</name>
                  <description>Entry waiting for the CPU to confirm it</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STATIC</name>
                  <description>Static entry that never ages out</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EGR_PRIO_EN</name>
              <description>Apply PRIO to frames sent to this address.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_OUT2</name>
          <description>Third word of the entry read by a FDB_OP.OP.GET_ONE or FDB_OP.OP.GET_NEXT command.</description>
          <addressOffset>0x4B8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>NEW_VID</name>
              <description>Replacement VLAN ID for frames matching the entry.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PRIO</name>
              <description>Priority given by this entry. It is a source for PORT_PRIO_ORD.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>IGR_PRIO_EN</name>
              <description>Apply PRIO to frames received from this address.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>COPY_TO_CPU</name>
              <description>Also copy frames to this address to the CPU.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>EGR_DROP</name>
              <description>Drop frames sent to this address.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>EGR_PORTS</name>
              <description>Ports that frames to this address are sent to. Each port has one bit.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>IGR_DROP</name>
              <description>Drop frames received from this address.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>MOVE_AGING_STATUS</name>
              <description>Ageing state of an entry that moved between ports.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FILTER_UNK_UCAST</name>
          <description>Ports that do not receive flooded frames with an unknown unicast destination.</description>
          <addressOffset>0x508</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>It is inferred from the word "filter" in the register name that frames of this class are not flooded to port port while its bit is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FILTER_UNK_MCAST</name>
          <description>Ports that do not receive flooded frames with an unknown multicast destination.</description>
          <addressOffset>0x50C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>It is inferred from the word "filter" in the register name that frames of this class are not flooded to port port while its bit is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FILTER_MCAST</name>
          <description>Ports that do not receive multicast frames.</description>
          <addressOffset>0x510</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>It is inferred from the word "filter" in the register name that frames of this class are not flooded to port port while its bit is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FILTER_BCAST</name>
          <description>Ports that do not receive broadcast frames.</description>
          <addressOffset>0x514</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>It is inferred from the word "filter" in the register name that frames of this class are not flooded to port port while its bit is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>VLAN_EGR_FILTER</name>
          <description>Per-port egress VLAN membership check.</description>
          <addressOffset>0x598</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORT%s</name>
              <description>Port port sends frames only of VLANs that list it.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LAG_GROUP[%s]</name>
          <description>Member ports and member count of one link aggregation group. Index: lag = 0 to 1.</description>
          <addressOffset>0x5A8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MEMBER_NUM</name>
              <description>Number of valid LAG_MEMBER slots of the group.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PORTS</name>
              <description>Member ports. Each port has one bit.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>8</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LAG_MEMBER[%s]</name>
          <description>Port in one of the four member slots of a group. The hash result picks a slot. Index: lag = 0 to 1, slot = 0 to 3. Flat index = 4 × lag + slot.</description>
          <addressOffset>0x5B0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PORT</name>
              <description>Port number in this slot.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CPU_COPY</name>
          <description>Chooses where frames that are trapped or copied to the CPU go.</description>
          <addressOffset>0x690</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TO_EXT_CPU</name>
              <description>Send such frames to the external CPU port set in EXT_CPU_PORT.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TO_INT_CPU</name>
              <description>Send such frames to the built-in microcontroller on port 10.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FORCE_INT_PORT</name>
              <description>Always send such frames to the built-in microcontroller port.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACL_PERMIT_UNMATCH</name>
          <description>Ports on which a frame that matches no ACL rule is forwarded.</description>
          <addressOffset>0x6A0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>yt921x_chip_setup_acl sets the bit of every port. It is inferred from the register name that port port then forwards received frames that match no rule.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACT_UNK_UCAST</name>
          <description>What the switch does with a frame whose unicast destination is not in the forwarding database, chosen per receiving port.</description>
          <addressOffset>0x734</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>2</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>ACT%s</name>
              <description>Action for frames received on port port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FORWARD</name>
                  <description>Flood the frame</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRAP</name>
                  <description>Send the frame to the CPU only</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DROP</name>
                  <description>Discard the frame</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COPY</name>
                  <description>Flood the frame and copy it to the CPU</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ACT_UNK_MCAST</name>
          <description>What the switch does with a frame whose multicast destination is not in the forwarding database, chosen per receiving port.</description>
          <addressOffset>0x738</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>2</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>ACT%s</name>
              <description>Action for frames received on port port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FORWARD</name>
                  <description>Flood the frame</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRAP</name>
                  <description>Send the frame to the CPU only</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DROP</name>
                  <description>Discard the frame</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COPY</name>
                  <description>Flood the frame and copy it to the CPU</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BYPASS_DROP_IGMP</name>
              <description>IGMP frames are exempt from the DROP action.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BYPASS_DROP_RMA</name>
              <description>Reserved multicast addresses are exempt from the DROP action.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FDB_HW_FLUSH</name>
          <description>Lets the switch remove learned addresses on its own.</description>
          <addressOffset>0x958</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ON_LINKDOWN</name>
              <description>Remove the dynamic entries of a port when its link goes down.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>4096</dim>
          <dimIncrement>0x8</dimIncrement>
          <name>VLAN_CTRL[%s]</name>
          <description>One 64-bit entry per VLAN ID. Write the low word, then the high word. VLAN table shows how to build an entry. Index: vid = 0 to 4095.</description>
          <addressOffset>0x8000</addressOffset>
          <register>
            <name>W0</name>
            <description>VLAN table entry: bits 31 to 0. One 64-bit entry per VLAN ID. Write the low word, then the high word. VLAN table shows how to build an entry.</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>METER_ID</name>
                <description>Meter number. It is an index of METER_CTRL.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>METER_EN</name>
                <description>Frames of this VLAN are rate limited by the meter in METER_ID.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>BYPASS_1X_AC</name>
                <description>Frames of this VLAN skip IEEE 802.1X access control.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <dim>11</dim>
                <dimIncrement>1</dimIncrement>
                <dimIndex>0-10</dimIndex>
                <name>PORTS%s</name>
                <description>Member ports. Each port has one bit.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PRIO</name>
                <description>VLAN priority. It is a source for PORT_PRIO_ORD.</description>
                <bitOffset>18</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PRIO_EN</name>
                <description>Frames of this VLAN get the priority in PRIO.</description>
                <bitOffset>21</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>LEARN_DIS</name>
                <description>Source addresses of frames in this VLAN are not learned.</description>
                <bitOffset>22</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>FID_LO</name>
                <description>Filtering ID for address learning and lookup. No function of the Linux driver writes it. yt921x_fdb_in01 writes the VLAN ID to FDB_IN1.FID, so the Linux driver addresses the forwarding database by VLAN ID. The vendor SDK function fal_tiger_vlan_fid_set() writes the field, and the comment on yt_vlan_svlMode_enable_set() states that the lookup uses the filtering ID once VLAN_CTRL.SVLAN_EN is set. The field crosses the boundary between the two words.</description>
                <bitOffset>23</bitOffset>
                <bitWidth>9</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W1</name>
            <description>VLAN table entry: bits 63 to 32. One 64-bit entry per VLAN ID. Write the low word, then the high word. VLAN table shows how to build an entry.</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>FID_HI</name>
                <description>Filtering ID for address learning and lookup. No function of the Linux driver writes it. yt921x_fdb_in01 writes the VLAN ID to FDB_IN1.FID, so the Linux driver addresses the forwarding database by VLAN ID. The vendor SDK function fal_tiger_vlan_fid_set() writes the field, and the comment on yt_vlan_svlMode_enable_set() states that the lookup uses the filtering ID once VLAN_CTRL.SVLAN_EN is set. The field crosses the boundary between the two words.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SVLAN_EN</name>
                <description>No function of the Linux driver sets it, as the comment in yt921x_vlan_aware_set states. The Linux name reads as a service VLAN enable. The vendor SDK names the bit SVL_EN and sets it in fal_tiger_vlan_svlMode_enable_set(); the comment on yt_vlan_svlMode_enable_set() reads "Set vlan svl mode.It will look up fid after enable svl." By that comment the bit makes the VLAN use VLAN_CTRL.FID for the address lookup, which disagrees with the reading of the Linux name.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>STP_ID</name>
                <description>Spanning tree instance of this VLAN. It selects the STP register.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <dim>11</dim>
                <dimIncrement>1</dimIncrement>
                <dimIndex>0-10</dimIndex>
                <name>UNTAG_PORTS%s</name>
                <description>Ports that send frames of this VLAN without a tag. Each port has one bit.</description>
                <bitOffset>8</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>ACL_ACTION</name>
      <description>ACL action table</description>
      <baseAddress>0x001C0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x17FC</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <cluster>
          <dim>384</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>ACL_ACT[%s]</name>
          <description>96-bit action of one rule. The entry index is 8 × blk + the group number of the rule in ACL_ENTRY.GRPID. Write the three words in rising address order. Index: entry = 0 to 383.</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>W0</name>
            <description>ACL action entry: bits 31 to 0. 96-bit action of one rule. The entry index is 8 × blk + the group number of the rule in ACL_ENTRY.GRPID. Write the three words in rising address order.</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>INTR_EN</name>
                <description>Raise an interrupt on a match.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>GPIO_PIN</name>
                <description>Pin number.</description>
                <bitOffset>1</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>GPIO_EN</name>
                <description>Signal a match on the pin in GPIO_PIN.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>FLOWSTAT_ID</name>
                <description>Flow counter number.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>6</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>FLOWSTAT_EN</name>
                <description>Count matching frames in the flow counter FLOWSTAT_ID.</description>
                <bitOffset>12</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>MIRROR_EN</name>
                <description>Copy matching frames to the monitor port in MIRROR.PORT.</description>
                <bitOffset>13</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>METER_EN</name>
                <description>Enables METER_ID.</description>
                <bitOffset>14</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>METER_ID</name>
                <description>Meter that rate limits matching frames. It is an index of METER_CTRL.</description>
                <bitOffset>15</bitOffset>
                <bitWidth>6</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DSCP_REPLACE</name>
                <description>Replace the IP DSCP value.</description>
                <bitOffset>21</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DSCP</name>
                <description>New IP DSCP value.</description>
                <bitOffset>22</bitOffset>
                <bitWidth>6</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>COLOR_EN</name>
                <description>Enables COLOR.</description>
                <bitOffset>28</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>COLOR</name>
                <description>Colour given to the frame.</description>
                <bitOffset>29</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GREEN</name>
                    <description>Green</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>YELLOW</name>
                    <description>Yellow</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RED</name>
                    <description>Red</description>
                    <value>2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PRIO_EN</name>
                <description>Enables PRIO.</description>
                <bitOffset>31</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W1</name>
            <description>ACL action entry: bits 63 to 32. 96-bit action of one rule. The entry index is 8 × blk + the group number of the rule in ACL_ENTRY.GRPID. Write the three words in rising address order.</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>PRIO</name>
                <description>Internal priority given to the frame. It is a source for PORT_PRIO_ORD.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CVID_REPLACE</name>
                <description>Replace the customer VLAN ID.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CVID</name>
                <description>New customer VLAN ID.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>12</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CPRI_REPLACE</name>
                <description>Replace the priority of the customer tag.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CPRI</name>
                <description>New priority of the customer tag.</description>
                <bitOffset>17</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CDEI_REPLACE</name>
                <description>Replace the drop eligible bit of the customer tag.</description>
                <bitOffset>20</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CDEI</name>
                <description>New drop eligible bit of the customer tag.</description>
                <bitOffset>21</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SVID_REPLACE</name>
                <description>Replace the service VLAN ID.</description>
                <bitOffset>22</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SVID_LO</name>
                <description>New service VLAN ID. The field crosses the boundary between words 1 and 2.</description>
                <bitOffset>23</bitOffset>
                <bitWidth>9</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W2</name>
            <description>ACL action entry: bits 95 to 64. 96-bit action of one rule. The entry index is 8 × blk + the group number of the rule in ACL_ENTRY.GRPID. Write the three words in rising address order.</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>SVID_HI</name>
                <description>New service VLAN ID. The field crosses the boundary between words 1 and 2.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SPRI_REPLACE</name>
                <description>Replace the priority of the service tag.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SPRI</name>
                <description>New priority of the service tag.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SDEI_REPLACE</name>
                <description>Replace the drop eligible bit of the service tag.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SDEI</name>
                <description>New drop eligible bit of the service tag.</description>
                <bitOffset>8</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>FWD_EN</name>
                <description>Enables the forwarding action.</description>
                <bitOffset>9</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <dim>11</dim>
                <dimIncrement>1</dimIncrement>
                <dimIndex>0-10</dimIndex>
                <name>FWD_REDIR_DPORTS%s</name>
                <description>Destination ports for COPY and REDIR. Each port has one bit. REDIR with no port set drops the frame.</description>
                <bitOffset>10</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>FWD</name>
                <description>Forwarding action. It is used when FWD_EN is set.</description>
                <bitOffset>21</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FWD</name>
                    <description>Forward normally</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>COPY</name>
                    <description>Forward and also send to FWD_REDIR_DPORTS</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>REDIR</name>
                    <description>Send only to FWD_REDIR_DPORTS</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TRAP</name>
                    <description>Send only to the CPU</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CTAG</name>
                <description>Customer tag handling on transmit.</description>
                <bitOffset>23</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DONTCARE</name>
                    <description>Leave to the normal VLAN rules</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UNTAG</name>
                    <description>Send without the tag</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TAG</name>
                    <description>Send with the tag</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>KEEP</name>
                    <description>Send as received</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STAG</name>
                <description>Service tag handling on transmit.</description>
                <bitOffset>25</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DONTCARE</name>
                    <description>Leave to the normal VLAN rules</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UNTAG</name>
                    <description>Send without the tag</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TAG</name>
                    <description>Send with the tag</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>KEEP</name>
                    <description>Send as received</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>ACL</name>
      <description>ACL keys and control</description>
      <baseAddress>0x00200000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x5F80</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>ACL_BLK_KEEP</name>
          <description>While a block is open, marks the key slots that the commit must leave unchanged.</description>
          <addressOffset>0x1000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-7</dimIndex>
              <name>KEEP%s</name>
              <description>Slot bin keeps its current key and mask.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>8</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-7</dimIndex>
              <name>GRPID%s</name>
              <description>Group number for slot bin during the commit.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACL_PORT</name>
          <description>Ports whose received frames are checked against the access control list.</description>
          <addressOffset>0x2000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>PORTS%s</name>
              <description>The access control list is applied to port port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACL_BLK_CMD</name>
          <description>Opens one ACL block for modification and commits it; see Writing a rule.</description>
          <addressOffset>0x2004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MODIFY</name>
              <description>Write 1 to open the block for writing. Write 0 to commit the changes.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BLKID</name>
              <description>Block number from 0 to 47.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>48</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>ACL_ENTRY[%s]</name>
          <description>Enables the eight key slots of one block and groups slots into rules. Slots with the same group number must all match for the rule to hit; the group number is also the slot whose ACL_ACT entry holds the action. Index: blk = 0 to 47.</description>
          <addressOffset>0x3000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>8</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-7</dimIndex>
              <name>EN%s</name>
              <description>Slot bin is in use.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>8</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-7</dimIndex>
              <name>GRPID%s</name>
              <description>Group number of slot bin. The slots of one rule share a group number.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>8</dim>
          <dimIncrement>0x200</dimIncrement>
          <name>ACL_KEY[%s]</name>
          <description>Value half of one key slot. Index blk is the block and bin the slot in the block. The layout of bits 35 to 0 and of the range flags depends on ACL_KEY.TYPE. Index: bin = 0 to 7; the member array index is blk.</description>
          <addressOffset>0x4000</addressOffset>
          <cluster>
            <dim>48</dim>
            <dimIncrement>0x8</dimIncrement>
            <name>BLK[%s]</name>
            <description>One ACL_KEY entry; index blk = 0 to 47.</description>
            <addressOffset>0x0</addressOffset>
            <register>
              <name>W0</name>
              <description>ACL key slot: bits 31 to 0. Value half of one key slot. Index blk is the block and bin the slot in the block. The layout of bits 35 to 0 and of the range flags depends on ACL_KEY.TYPE.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
            </register>
            <register>
              <name>W0_MAC_ADDR0</name>
              <description>ACL key slot, bits 31 to 0, layout for key types MAC_DA0, MAC_SA0: MAC address high 32 bits</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>MAC address bytes 0 to 3. Byte 0 is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_MAC_DA1_SA1</name>
              <description>ACL key slot, bits 31 to 0, layout for key types MAC_DA1_SA1: MAC address low 16 bits of destination and source</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>MAC_SA1</name>
                  <description>Source MAC address bytes 4 and 5.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>MAC_DA1</name>
                  <description>Destination MAC address bytes 4 and 5.</description>
                  <bitOffset>16</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_VLAN</name>
              <description>ACL key slot, bits 31 to 0, layout for key types VLAN: VLAN tags with tag format</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>CVID</name>
                  <description>Customer VLAN ID.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>12</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SVID</name>
                  <description>Service VLAN ID.</description>
                  <bitOffset>12</bitOffset>
                  <bitWidth>12</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>STAG_FMT</name>
                  <description>Service tag format of the frame. The Linux driver gives no codes. The vendor SDK list yt_vlan_format_t gives 0 for untagged, 1 for priority-tagged and 2 for tagged.</description>
                  <bitOffset>24</bitOffset>
                  <bitWidth>2</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SPRI</name>
                  <description>Priority of the service tag.</description>
                  <bitOffset>26</bitOffset>
                  <bitWidth>3</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SDEI</name>
                  <description>Drop eligible bit of the service tag.</description>
                  <bitOffset>29</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CTAG_FMT</name>
                  <description>Customer tag format of the frame. The Linux driver gives no codes. The vendor SDK list yt_vlan_format_t gives 0 for untagged, 1 for priority-tagged and 2 for tagged.</description>
                  <bitOffset>30</bitOffset>
                  <bitWidth>2</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_VTAG</name>
              <description>ACL key slot, bits 31 to 0, layout for key types VTAG: VLAN tags</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>CVID</name>
                  <description>Customer VLAN ID.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>12</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SVID</name>
                  <description>Service VLAN ID.</description>
                  <bitOffset>12</bitOffset>
                  <bitWidth>12</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SPRI</name>
                  <description>Priority of the service tag.</description>
                  <bitOffset>24</bitOffset>
                  <bitWidth>3</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SDEI</name>
                  <description>Drop eligible bit of the service tag.</description>
                  <bitOffset>27</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CPRI</name>
                  <description>Priority of the customer tag.</description>
                  <bitOffset>28</bitOffset>
                  <bitWidth>3</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CDEI</name>
                  <description>Drop eligible bit of the customer tag.</description>
                  <bitOffset>31</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_IPV4</name>
              <description>ACL key slot, bits 31 to 0, layout for key types IPV4_DA, IPV4_SA: IPv4 address</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>IPv4 address. The first byte is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_IPV6_ADDR0</name>
              <description>ACL key slot, bits 31 to 0, layout for key types IPV6_DA0, IPV6_SA0: IPv6 address bits 127 to 96</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>32 bits of the IPv6 address. The most significant byte is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_IPV6_ADDR1</name>
              <description>ACL key slot, bits 31 to 0, layout for key types IPV6_DA1, IPV6_SA1: IPv6 address bits 95 to 64</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>32 bits of the IPv6 address. The most significant byte is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_IPV6_ADDR2</name>
              <description>ACL key slot, bits 31 to 0, layout for key types IPV6_DA2, IPV6_SA2: IPv6 address bits 63 to 32</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>32 bits of the IPv6 address. The most significant byte is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_IPV6_ADDR3</name>
              <description>ACL key slot, bits 31 to 0, layout for key types IPV6_DA3, IPV6_SA3: IPv6 address bits 31 to 0</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ADDR</name>
                  <description>32 bits of the IPv6 address. The most significant byte is in bits 31 to 24.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>32</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_MISC</name>
              <description>ACL key slot, bits 31 to 0, layout for key types MISC: IP header and TCP flags</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>L3_TYPE</name>
                  <description>Layer 3 protocol class.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>4</bitWidth>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>OTHER</name>
                      <description>Any other protocol</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IPV4</name>
                      <description>IPv4</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>IPV6</name>
                      <description>IPv6</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ARP</name>
                      <description>ARP</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LLDP</name>
                      <description>LLDP</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PAE</name>
                      <description>IEEE 802.1X port access entity</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ERP</name>
                      <description>Ethernet ring protection. The meaning is inferred from the name; yt921x_acl_rule_ext_parse_flow_entries selects the value for the EtherType ETH_P_CFM.</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>SLOW_PROTOCOL</name>
                      <description>IEEE 802.3 slow protocols such as LACP</description>
                      <value>7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>TOS</name>
                  <description>IPv4 type of service or IPv6 traffic class byte.</description>
                  <bitOffset>4</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>IP_PROTO</name>
                  <description>IP protocol number.</description>
                  <bitOffset>12</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>TCP_FLAGS</name>
                  <description>TCP flags byte.</description>
                  <bitOffset>20</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>IP_OPTION</name>
                  <description>The packet has IP options or extension headers.</description>
                  <bitOffset>28</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>FIRST_FRAG</name>
                  <description>The packet is the first fragment.</description>
                  <bitOffset>29</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>PPPOE_FLAG</name>
                  <description>The frame carries PPPoE.</description>
                  <bitOffset>30</bitOffset>
                  <bitWidth>1</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_L4</name>
              <description>ACL key slot, bits 31 to 0, layout for key types L4: Layer 4 ports</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>SPORT</name>

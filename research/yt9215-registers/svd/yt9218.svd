              <description>The receive side of the MAC is enabled.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_PAUSE</name>
              <description>Transmit pause is active.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_PAUSE</name>
              <description>Receive pause is active.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DUPLEX_FULL</name>
              <description>1 for full duplex.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>LINK</name>
              <description>1 while the link is up.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PON_STRAP_FUNC</name>
          <description>Selects, per function, whether the switch uses the level sampled on the strap pin at power-on (bit clear) or the value in PON_STRAP_VAL (bit set). This split between the two registers is inferred from their names. yt921x_set_eee writes the same value to the EEE bit of both.</description>
          <addressOffset>0x320</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LOOP_DETECT</name>
              <description>Take the loop detection setting from PON_STRAP_VAL.LOOP_DETECT.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE</name>
              <description>Take the Energy Efficient Ethernet setting from PON_STRAP_VAL.EEE. yt921x_set_eee sets this bit together with PON_STRAP_VAL.EEE to turn the function on; the role of each bit alone is inferred from the register names.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PON_STRAP_VAL</name>
          <description>Values used in place of the power-on straps for every function whose bit is set in PON_STRAP_FUNC.</description>
          <addressOffset>0x324</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>LOOP_DETECT</name>
              <description>Loop detection strap value. The vendor SDK function fal_tiger_loop_detect_enable_set() clears this bit and sets PON_STRAP_FUNC.LOOP_DETECT to turn loop detection on, and its comment calls the strap "dis lpd strap". By that code 1 turns loop detection off.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE</name>
              <description>1 turns Energy Efficient Ethernet on. yt921x_set_eee sets this bit together with PON_STRAP_FUNC.EEE; the role of each bit alone is inferred from the register names.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PON_STRAP_CAP</name>
          <description>Levels that were sampled on the strap pins at power-on.</description>
          <addressOffset>0x328</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>LOOP_DETECT</name>
              <description>Captured loop detection strap.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>EEE</name>
              <description>Captured Energy Efficient Ethernet strap.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimIndex>8-9</dimIndex>
          <name>MDIO_POLLING_%s</name>
          <description>Link state of port 8 or 9. yt921x_port_up writes the link state here for an external port that does not use its SerDes. It is inferred from the name that the switch otherwise learns the state by polling a PHY on the external MDIO bus. Index: port = 8 to 9.</description>
          <addressOffset>0x364</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SPEED</name>
              <description>Link speed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V10</name>
                  <description>10 Mbit/s</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V100</name>
                  <description>100 Mbit/s</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V1000</name>
                  <description>1000 Mbit/s</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V10000</name>
                  <description>10000 Mbit/s</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V2500</name>
                  <description>2500 Mbit/s</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LINK</name>
              <description>1 for link up.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DUPLEX_FULL</name>
              <description>1 for full duplex.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SENSOR</name>
          <description>Enables the on-chip sensors.</description>
          <addressOffset>0x36C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TEMP</name>
              <description>Enables the temperature sensor that TEMP reads.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TEMP</name>
          <description>Reading of the temperature sensor. No function of the Linux driver reads the register. :ref:`bringup-temp` gives the conversion that the vendor SDK uses.</description>
          <addressOffset>0x374</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Sensor value. The vendor SDK function fal_tiger_sensor_temp_value_get() uses bits 15 to 0, in steps of 1/128 °C.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHIP_MODE</name>
          <description>Tells the parts of one family apart. :ref:`reference-parts` lists the value of each part.</description>
          <addressOffset>0x388</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MODE</name>
              <description>Package variant code.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>XMII_CTRL</name>
          <description>Enables the parallel MAC interface (MII, RMII or RGMII) pins of ports 8 and 9. The bit order is the reverse of the port order.</description>
          <addressOffset>0x394</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PORT_8</name>
              <description>Bit 1 enables the xMII pins of port 8. Bit 0 enables the xMII pins of port 9.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PORT_9</name>
              <description>Bit 1 enables the xMII pins of port 8. Bit 0 enables the xMII pins of port 9.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>0x8</dimIncrement>
          <dimIndex>8-9</dimIndex>
          <name>XMII_%s</name>
          <description>Mode, clock direction and RGMII delays of one parallel MAC interface. Index: port = 8 to 9.</description>
          <addressOffset>0x400</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>REVMII_RX_CLK_OUT</name>
              <description>Drives the MII receive clock when the switch is the PHY side.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REVMII_TX_CLK_OUT</name>
              <description>Drives the MII transmit clock when the switch is the PHY side.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RMII_PHY_TX_CLK_OUT</name>
              <description>Drives the RMII reference clock when the switch is the PHY side.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RGMII_RX_DELAY_150PS</name>
              <description>RGMII receive clock delay in steps of 150 ps, by the comment in fal_tiger_port.c of the vendor SDK.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RGMII_TX_CLK_OUT</name>
              <description>Drives the RGMII transmit clock.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RGMII_TX_DELAY_2NS</name>
              <description>Adds 2 ns to the delay of the RGMII transmit clock, by the comment in fal_tiger_port.c of the vendor SDK.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_CLK_IN</name>
              <description>The receive clock pin is an input.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TX_CLK_IN</name>
              <description>The Linux name reads as: the transmit clock pin is an input. The vendor SDK names the bit XMII_TXC_IN_SEL, and its function fal_tiger_port_extif_xmiiClk_invert_set() writes the bit as the enable of an inverted xMII clock. The two readings disagree, and it is not known which is right.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RGMII_TX_DELAY_150PS</name>
              <description>Fine RGMII transmit clock delay in steps of 150 ps. A comment in fal_tiger_port.c of the vendor SDK gives the transmit clock delay as 2 ns times XMII.RGMII_TX_DELAY_2NS plus 0.15 ns times this field.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SOFT_RST</name>
              <description>Resets the interface logic.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN</name>
              <description>Enables the interface.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LINK</name>
              <description>Forces the link of the interface up.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE</name>
              <description>Interface type.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MII</name>
                  <description>MII as the MAC side</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REVMII</name>
                  <description>MII as the PHY side</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RMII</name>
                  <description>RMII as the MAC side</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REVRMII</name>
                  <description>RMII as the PHY side</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RGMII</name>
                  <description>RGMII</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Interface off</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x1000</dimIncrement>
          <name>MAC_FRAME[%s]</name>
          <description>Largest frame the MAC of one port accepts. Index: port = 0 to 10.</description>
          <addressOffset>0x1008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SIZE</name>
              <description>Maximum frame length in bytes. The length counts from the destination address to the frame check sequence. The largest value is 0x2400 (9216).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>14</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EEE_MAC</name>
      <description>Per-port EEE</description>
      <baseAddress>0x000A0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x284</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>11</dim>
          <dimIncrement>0x40</dimIncrement>
          <name>EEE_VAL[%s]</name>
          <description>Per-port Energy Efficient Ethernet bit that yt921x_set_eee sets and clears together with EEE_CTRL.EN of the port. It is not known what the bit does alone. Index: port = 0 to 10.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>DATA</name>
              <description>Set to turn Energy Efficient Ethernet on for the port and cleared to turn it off, as yt921x_set_eee does.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>EEE</name>
      <description>EEE control</description>
      <baseAddress>0x000B0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>EEE_CTRL</name>
          <description>One Energy Efficient Ethernet enable bit per port; see Energy Efficient Ethernet.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>EN%s</name>
              <description>Enables Energy Efficient Ethernet on port port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MIB</name>
      <description>Port counters</description>
      <baseAddress>0x000C0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0xC00</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MIB_CTRL</name>
          <description>Clears port counters.</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ALL_PORT</name>
              <description>It is inferred from the name that the bit clears the counters of every port. The vendor SDK function fal_tiger_stat_mib_clear_all() leaves the bit at 0 for a clear of every port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ONE_PORT</name>
              <description>Clear the counters of the port in PORT.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PORT</name>
              <description>Port whose counters are cleared when ONE_PORT is set.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CLEAN</name>
              <description>Write 1 to clear the selected counters.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>11</dim>
          <dimIncrement>0x100</dimIncrement>
          <name>MIB[%s]</name>
          <description>Counters of one port. Start of the counter block of one port. Each counter sits at a fixed byte offset inside the block, listed in Port counters.</description>
          <addressOffset>0x100</addressOffset>
          <register>
            <name>RX_BROADCAST</name>
            <description>Broadcast frames received</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PAUSE</name>
            <description>Pause frames received</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_MULTICAST</name>
            <description>Multicast frames received</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_CRC_ERR</name>
            <description>Frames received with a bad frame check sequence</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_ALIGN_ERR</name>
            <description>Frames received with an alignment error</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_UNDERSIZE_ERR</name>
            <description>Frames received shorter than 64 bytes with a good frame check sequence</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_FRAG_ERR</name>
            <description>Frames received shorter than 64 bytes with a bad frame check sequence</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_64</name>
            <description>Frames received with a length of 64 bytes</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_65_TO_127</name>
            <description>Frames received with a length of 65 to 127 bytes</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_128_TO_255</name>
            <description>Frames received with a length of 128 to 255 bytes</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_256_TO_511</name>
            <description>Frames received with a length of 256 to 511 bytes</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_512_TO_1023</name>
            <description>Frames received with a length of 512 to 1023 bytes</description>
            <addressOffset>0x2C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_1024_TO_1518</name>
            <description>Frames received with a length of 1024 to 1518 bytes</description>
            <addressOffset>0x30</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_PKT_SZ_1519_TO_MAX</name>
            <description>Frames received longer than 1518 bytes</description>
            <addressOffset>0x34</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_GOOD_BYTES</name>
            <description>Bytes received in good frames</description>
            <addressOffset>0x3C</addressOffset>
            <size>64</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_BAD_BYTES</name>
            <description>Bytes received in bad frames</description>
            <addressOffset>0x44</addressOffset>
            <size>64</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_OVERSIZE_ERR</name>
            <description>Frames received longer than the frame size limit</description>
            <addressOffset>0x4C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_DROPPED</name>
            <description>Received frames dropped by the switch</description>
            <addressOffset>0x50</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_BROADCAST</name>
            <description>Broadcast frames sent</description>
            <addressOffset>0x54</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PAUSE</name>
            <description>Pause frames sent</description>
            <addressOffset>0x58</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_MULTICAST</name>
            <description>Multicast frames sent</description>
            <addressOffset>0x5C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_UNDERSIZE_ERR</name>
            <description>Frames sent shorter than 64 bytes</description>
            <addressOffset>0x60</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_64</name>
            <description>Frames sent with a length of 64 bytes</description>
            <addressOffset>0x64</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_65_TO_127</name>
            <description>Frames sent with a length of 65 to 127 bytes</description>
            <addressOffset>0x68</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_128_TO_255</name>
            <description>Frames sent with a length of 128 to 255 bytes</description>
            <addressOffset>0x6C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_256_TO_511</name>
            <description>Frames sent with a length of 256 to 511 bytes</description>
            <addressOffset>0x70</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_512_TO_1023</name>
            <description>Frames sent with a length of 512 to 1023 bytes</description>
            <addressOffset>0x74</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_1024_TO_1518</name>
            <description>Frames sent with a length of 1024 to 1518 bytes</description>
            <addressOffset>0x78</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT_SZ_1519_TO_MAX</name>
            <description>Frames sent longer than 1518 bytes</description>
            <addressOffset>0x7C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_GOOD_BYTES</name>
            <description>Bytes sent in good frames</description>
            <addressOffset>0x84</addressOffset>
            <size>64</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_COLLISION</name>
            <description>Collisions seen while sending</description>
            <addressOffset>0x8C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_EXCESSIVE_COLLISION</name>
            <description>Frames not sent after 16 collisions</description>
            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_MULTIPLE_COLLISION</name>
            <description>Frames sent after more than one collision</description>
            <addressOffset>0x94</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_SINGLE_COLLISION</name>
            <description>Frames sent after exactly one collision</description>
            <addressOffset>0x98</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_PKT</name>
            <description>Good frames sent</description>
            <addressOffset>0x9C</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_DEFERRED</name>
            <description>Frames whose first transmit attempt was deferred</description>
            <addressOffset>0xA0</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_LATE_COLLISION</name>
            <description>Collisions seen later than 512 bit times into a frame</description>
            <addressOffset>0xA4</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>RX_OAM</name>
            <description>OAM frames received</description>
            <addressOffset>0xA8</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
          <register>
            <name>TX_OAM</name>
            <description>OAM frames sent</description>
            <addressOffset>0xAC</addressOffset>
            <size>32</size>
            <access>read-only</access>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>LED</name>
      <description>LED control</description>
      <baseAddress>0x000D0000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1F8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>LED_CTRL</name>
          <description>Chooses between parallel and serial LED outputs and sets the loop detection blink rate.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>MODE</name>
              <description>LED output mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PARALLEL</name>
                  <description>One pin per LED</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SERIAL</name>
                  <description>LED states shifted out on a clock and data pin pair</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PORT_NUM</name>
              <description>Number of ports shifted out in serial mode.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LOOPDETECT_BLINK</name>
              <description>Blink cycle that signals a detected loop. The comment on the field gives the cycle as 512 ms times the field value. The vendor SDK list yt_led_loopdetect_blink_rate_t gives 512 ms for the value 0 and 2048 ms for the value 3, which is 512 ms times the field value plus one. It is not known which is right.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UNK</name>
              <description>The vendor SDK function fal_tiger_led_enable() sets the bit under the comment "enabel LED". The Linux driver does not name its function.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>10</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LED0_PORT[%s]</name>
          <description>Conditions that light or blink LED 0 of one port. Each set bit adds one condition; the LED shows the combination. LEDs explains the three LED groups. Index: port = 0 to 9.</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ACT_10M_BLINK</name>
              <description>Blink on activity at 10 Mbit/s.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M_BLINK</name>
              <description>Blink on activity at 100 Mbit/s.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M_BLINK</name>
              <description>Blink on activity at 1000 Mbit/s.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_COLLISION_BLINK</name>
              <description>Blink on collisions.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_10M</name>
              <description>On while the link is up at 10 Mbit/s.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M</name>
              <description>On while the link is up at 100 Mbit/s.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M</name>
              <description>On while the link is up at 1000 Mbit/s.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX</name>
              <description>On while frames are received.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX</name>
              <description>On while frames are sent.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX_BLINK</name>
              <description>Blink while frames are received.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX_BLINK</name>
              <description>Blink while frames are sent.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_HALF</name>
              <description>On while the link is up in half duplex.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_FULL</name>
              <description>On while the link is up in full duplex.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_ACTIVE_BLINK</name>
              <description>Blink on any activity.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_LOOPDETECT_BLINK</name>
              <description>Blink when a loop is detected on the port.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_EEE_BLINK</name>
              <description>Blink while the port is in low power idle.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_COLLISION_BLINK_INDI</name>
              <description>Only LED 0 has the field. The vendor SDK action list names the bit LED_ACTION_COLLISION_BLINK. It is inferred from the name that the LED blinks on a collision.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_LINK_TRY_DIS</name>
              <description>Only LED 0 has the field. The vendor SDK action list names the bit LED_ACTION_DISABLE_LINK_TRY, and fal_tiger_led_action_set() sets it for LED 0 in every case, under the comment "tiger must set disable_link_try bit to 1". What the bit does is not known.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>10</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LED1_PORT[%s]</name>
          <description>Conditions that light or blink LED 1 of one port, plus the blink timing shared by all three LEDs of the port. Index: port = 0 to 9.</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ACT_10M_BLINK</name>
              <description>Blink on activity at 10 Mbit/s.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M_BLINK</name>
              <description>Blink on activity at 100 Mbit/s.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M_BLINK</name>
              <description>Blink on activity at 1000 Mbit/s.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_COLLISION_BLINK</name>
              <description>Blink on collisions.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_10M</name>
              <description>On while the link is up at 10 Mbit/s.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M</name>
              <description>On while the link is up at 100 Mbit/s.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M</name>
              <description>On while the link is up at 1000 Mbit/s.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX</name>
              <description>On while frames are received.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX</name>
              <description>On while frames are sent.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX_BLINK</name>
              <description>Blink while frames are received.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX_BLINK</name>
              <description>Blink while frames are sent.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_HALF</name>
              <description>On while the link is up in half duplex.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_FULL</name>
              <description>On while the link is up in full duplex.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_ACTIVE_BLINK</name>
              <description>Blink on any activity.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_LOOPDETECT_BLINK</name>
              <description>Blink when a loop is detected on the port.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_EEE_BLINK</name>
              <description>Blink while the port is in low power idle.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BLINK_DUTY</name>
              <description>Fraction of the blink cycle the LED is on.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>V1_2</name>
                  <description>On for 1/2 of the cycle</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V2_3</name>
                  <description>On for 2/3 of the cycle</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V3_4</name>
                  <description>On for 3/4 of the cycle</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>V5_6</name>
                  <description>On for 5/6 of the cycle</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BLINK_DUTY_COMP</name>
              <description>Swaps the on and off parts of the blink cycle. BLINK_DUTY then gives the off fraction.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_BLINK</name>
              <description>Blink cycle of the low power idle indication. The cycle is 512 ms shifted right by the field value.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OTHER_BLINK</name>
              <description>Alternative blink cycle. The cycle is 512 ms shifted right by the field value. An LED uses it when its LED2_PORT.FORCE_BLINK field is 3.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>10</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LED2_PORT[%s]</name>
          <description>Conditions that light or blink LED 2 of one port, plus the forced state of all three LEDs of the port. Index: port = 0 to 9.</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ACT_10M_BLINK</name>
              <description>Blink on activity at 10 Mbit/s.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M_BLINK</name>
              <description>Blink on activity at 100 Mbit/s.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M_BLINK</name>
              <description>Blink on activity at 1000 Mbit/s.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_COLLISION_BLINK</name>
              <description>Blink on collisions.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_10M</name>
              <description>On while the link is up at 10 Mbit/s.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_100M</name>
              <description>On while the link is up at 100 Mbit/s.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_1000M</name>
              <description>On while the link is up at 1000 Mbit/s.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX</name>
              <description>On while frames are received.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX</name>
              <description>On while frames are sent.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_RX_BLINK</name>
              <description>Blink while frames are received.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_TX_BLINK</name>
              <description>Blink while frames are sent.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_HALF</name>
              <description>On while the link is up in half duplex.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_DUPLEX_FULL</name>
              <description>On while the link is up in full duplex.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_ACTIVE_BLINK</name>
              <description>Blink on any activity.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_LOOPDETECT_BLINK</name>
              <description>Blink when a loop is detected on the port.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACT_EEE_BLINK</name>
              <description>Blink while the port is in low power idle.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>3</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-2</dimIndex>
              <name>FORCE_BLINK%s</name>
              <description>Blink cycle of an LED that is forced to blink. The cycle is 512 ms shifted left by the field value.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OTHER</name>
                  <description>Use the cycle in LED1_PORT.OTHER_BLINK</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <dim>3</dim>
              <dimIncrement>4</dimIncrement>
              <dimIndex>0-2</dimIndex>
              <name>FORCE%s</name>
              <description>Forced state of LED group grp of this port.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DONTCARE</name>
                  <description>Not forced. The LED follows its behaviour bits</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BLINK</name>
                  <description>Blink at the rate in FORCE_BLINK</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON</name>
                  <description>On</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFF</name>
                  <description>Off</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>LED_SER_CTRL</name>
          <description>Settings of the serial LED output.</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>GRP_NUM</name>
              <description>Number of LED groups shifted out per port minus one.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ACTIVE_LOW</name>
              <description>Serial LED data is active low.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UNK</name>
              <description>The vendor SDK function fal_tiger_led_serial_enable_set() sets both bits to turn the serial LED output on and clears both to turn it off. The comment on the field in the Linux driver reads "delay?".</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>6</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LED_SER_MAP[%s]</name>
          <description>Chooses which LED is shifted out at each position of the serial stream. One register holds five positions; index half is 0 for ports 0 to 4 and 1 for ports 5 to 9. Index: grp = 0 to 2, half = 0 to 1. Flat index = 2 × (2 − grp) + half.</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>5</dim>
              <dimIncrement>6</dimIncrement>
              <dimIndex>0-4</dimIndex>
              <name>DST_LED%s</name>
              <description>LED group shown at position slot.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>5</dim>
              <dimIncrement>6</dimIncrement>
              <dimIndex>0-4</dimIndex>
              <name>DST_PORT%s</name>
              <description>Port whose LED is shown at position slot.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LED_PAR_PORTS</name>
          <description>Parallel LED outputs in use. The Linux driver defines the address only.</description>
          <addressOffset>0x1C4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>The vendor SDK function fal_tiger_led_parallel_output_set() writes a port mask to bits 9 to 0, one bit per port, under the comment "select output port mask of parallel LED". Bits 31 to 10 are not known.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LED_PAR_INV</name>
          <description>Inverts individual parallel LED outputs. With the bit clear the pin is low while the LED is on, which suits an LED wired active low; set the bit for an LED wired active high.</description>
          <addressOffset>0x1C8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INV_0_0</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_1</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_2</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_3</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_4</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_5</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_6</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_7</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_8</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_0_9</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_1_0</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_1_1</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_1_2</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV_1_3</name>
              <description>Inverts the output of one LED group of one port. The bit number is 10 × grp + port.</description>

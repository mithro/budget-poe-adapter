    <peripheral>
      <name>PARSER</name>
      <description>Ingress parser</description>
      <baseAddress>0x00210000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0xD4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>4</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>TPID_IGR[%s]</name>
          <description>Four tag protocol identifier values the parser can recognise as a VLAN tag. PORT_IGR_TPID chooses which of them each port accepts. Index: n = 0 to 3.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>TPID</name>
              <description>Tag protocol identifier. An example is 0x8100.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_IGR_TPID[%s]</name>
          <description>Chooses which TPID_IGR entries one port treats as a customer tag and which as a service tag. VLAN-aware and VLAN-unaware ports shows how this makes a port ignore VLAN tags. Index: port = 0 to 10.</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-3</dimIndex>
              <name>CTAG%s</name>
              <description>Entry n of TPID_IGR marks a customer tag on this port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>4</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-3</dimIndex>
              <name>STAG%s</name>
              <description>Entry n of TPID_IGR marks a service tag on this port.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LAG_HASH</name>
          <description>Frame fields that feed the hash which spreads traffic over the members of a group.</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SRC_PORT</name>
              <description>Include the receiving port.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_DA</name>
              <description>Include the destination MAC address.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_SA</name>
              <description>Include the source MAC address.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IP_DST</name>
              <description>Include the IP destination address.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IP_SRC</name>
              <description>Include the IP source address.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IP_PROTO</name>
              <description>Include the IP protocol number.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L4_DPORT</name>
              <description>Include the layer 4 destination port.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>L4_SPORT</name>
              <description>Include the layer 4 source port.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>16</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>UDF_CTRL[%s]</name>
          <description>Position of one two-byte window that ACL keys of type UDF can match. Key type UDFk matches windows 2k and 2k + 1. Index: n = 0 to 15.</description>
          <addressOffset>0x94</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>UDF_OFFSET</name>
              <description>Offset in bytes of the two-byte window from the start of that header.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UDF_TYPE</name>
              <description>Header the offset is counted from.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>L2</name>
                  <description>Start of the Ethernet header</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>L3</name>
                  <description>Start of the layer 3 header</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>L4</name>
                  <description>Start of the layer 4 header</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>METER</name>
      <description>Ingress meters</description>
      <baseAddress>0x00220000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1258</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_RATE[%s]</name>
          <description>Per-frame overhead that rate limiting adds to the frame length. Index: port = 0 to 10.</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>GAP_VALUE</name>
              <description>Bytes added per frame for preamble and inter-frame gap. A meter adds them when METER_CTRL.BYTE_MODE_INCLUDE_GAP is set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>METER_SLOT</name>
          <description>Period at which every meter adds tokens to its buckets.</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SLOT</name>
              <description>Slot length in units of eight core clock periods. SYS_CLK shows the core clock. The smallest allowed value is 80.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_METER[%s]</name>
          <description>Attaches one of the per-port meters to the receive side of a port. Index: port = 0 to 10.</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ID</name>
              <description>Port meter number n. The meter is entry 64 + n of METER_CTRL.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EN</name>
              <description>Enables ingress rate limiting on the port.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>75</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>METER_CTRL[%s]</name>
          <description>96-bit configuration of one two-rate token bucket meter. Entries 0 to 63 are general-purpose meters for ACL rules; entries 64 to 74 are the per-port meters. Token arithmetic gives the conversion from bit rates. Index: meter = 0 to 74.</description>
          <addressOffset>0x800</addressOffset>
          <register>
            <name>W0</name>
            <description>Meter configuration: bits 31 to 0. 96-bit configuration of one two-rate token bucket meter. Entries 0 to 63 are general-purpose meters for ACL rules; entries 64 to 74 are the per-port meters. Token arithmetic gives the conversion from bit rates.</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>EIR</name>
                <description>Excess information rate in tokens per time slot.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>18</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EBS_LO</name>
                <description>Excess burst size in tokens. The field crosses the boundary between words 0 and 1.</description>
                <bitOffset>18</bitOffset>
                <bitWidth>14</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W1</name>
            <description>Meter configuration: bits 63 to 32. 96-bit configuration of one two-rate token bucket meter. Entries 0 to 63 are general-purpose meters for ACL rules; entries 64 to 74 are the per-port meters. Token arithmetic gives the conversion from bit rates.</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>EBS_HI</name>
                <description>Excess burst size in tokens. The field crosses the boundary between words 0 and 1.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CIR</name>
                <description>Committed information rate in tokens per time slot.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>18</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CBS_LO</name>
                <description>Committed burst size in tokens. The field crosses the boundary between words 1 and 2.</description>
                <bitOffset>20</bitOffset>
                <bitWidth>12</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W2</name>
            <description>Meter configuration: bits 95 to 64. 96-bit configuration of one two-rate token bucket meter. Entries 0 to 63 are general-purpose meters for ACL rules; entries 64 to 74 are the per-port meters. Token arithmetic gives the conversion from bit rates.</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>CBS_HI</name>
                <description>Committed burst size in tokens. The field crosses the boundary between words 1 and 2.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>RFC2698</name>
                <description>Select the algorithm of RFC 2698. Value 0 selects that of RFC 4115.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PKT_MODE</name>
                <description>Meter packets. Value 0 meters bytes.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>BYTE_MODE_INCLUDE_GAP</name>
                <description>Add PORT_RATE.GAP_VALUE bytes to each frame in byte mode.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>UNIT</name>
                <description>Token scale. Every token value is multiplied by 4 to the power of UNIT.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>COLOR_BLIND</name>
                <description>Ignore the colour the frame already has.</description>
                <bitOffset>10</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DROP</name>
                <description>Colours that are dropped.</description>
                <bitOffset>11</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>GYR</name>
                    <description>Drop every frame</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>YR</name>
                    <description>Drop yellow and red frames</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>R</name>
                    <description>Drop red frames</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NONE</name>
                    <description>Drop nothing and only colour the frame</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TOKEN_OVERFLOW_EN</name>
                <description>Tokens that overflow the committed bucket spill into the excess bucket. This meaning is inferred from a comment. The comment on the field reads "RFC4115: yellow use unused green bw".</description>
                <bitOffset>13</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>METER_EN</name>
                <description>Enables the meter.</description>
                <bitOffset>14</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>75</dim>
          <dimIncrement>0x8</dimIncrement>
          <name>METER_STAT[%s]</name>
          <description>Current token counts of one meter. The bit layout is not known. Index: meter = 0 to 74.</description>
          <addressOffset>0x1000</addressOffset>
          <register>
            <name>W0</name>
            <description>Meter token state: bits 31 to 0. Current token counts of one meter. The bit layout is not known.</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <fields>
              <field>
                <name>VALUE_LO</name>
                <description>Layout not known.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W1</name>
            <description>Meter token state: bits 63 to 32. Current token counts of one meter. The bit layout is not known.</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <fields>
              <field>
                <name>VALUE_HI</name>
                <description>Layout not known.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>PORT_VLAN</name>
      <description>Ingress port VLAN</description>
      <baseAddress>0x00230000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0xAC</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_VLAN_CTRL[%s]</name>
          <description>VLAN IDs and priorities given to frames that arrive on a port without the matching tag. Index: port = 0 to 10.</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CVLAN_PRIO</name>
              <description>Default customer tag priority.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVLAN_PRIO</name>
              <description>Default service tag priority.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CVID</name>
              <description>Default customer VLAN ID (the port VLAN ID).</description>
              <bitOffset>6</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVID</name>
              <description>Default service VLAN ID.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CVLAN_PRIO_EN</name>
              <description>The Linux name reads as: use PORT_VLAN_CTRL.CVLAN_PRIO as the default customer tag priority. The vendor SDK names the bit PRIORITY_TAG_CVID_EN, which reads as: give the default customer VLAN ID to a priority-tagged frame. No code of either source uses the bit, and it is not known which reading is right.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVLAN_PRIO_EN</name>
              <description>The Linux name reads as: use PORT_VLAN_CTRL.SVLAN_PRIO as the default service tag priority. The vendor SDK names the bit PRIORITY_TAG_SVID_EN, which reads as: give the default service VLAN ID to a priority-tagged frame. No code of either source uses the bit, and it is not known which reading is right.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_VLAN_CTRL1[%s]</name>
          <description>Drops tagged or untagged frames on receive, per tag kind. Index: port = 0 to 10.</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CVLAN_DROP_UNTAGGED</name>
              <description>Drop received frames that carry no customer tag.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CVLAN_DROP_TAGGED</name>
              <description>yt921x_vlan_filtering always clears the bit. It is inferred from the name that a set bit drops received frames that carry a customer tag.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVLAN_DROP_UNTAGGED</name>
              <description>Drop received frames that carry no service tag.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SVLAN_DROP_TAGGED</name>
              <description>Drop received frames that carry a service tag.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VLAN_RANGE_PROFILE_ID</name>
              <description>VLAN range profile number.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VLAN_RANGE_EN</name>
              <description>The Linux name reads as an enable of VLAN range matching with the profile in PORT_VLAN_CTRL1.VLAN_RANGE_PROFILE_ID. The vendor SDK names the bit VLAN_RANGE_MODE, and fal_tiger_vlan_trans_mode_set() writes a value of the list yt_vlan_range_trans_mode_t to it: 0 for the customer tag and 1 for the service tag. By that code the bit selects the tag that range matching uses, which disagrees with the Linux name. It is not known which is right.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>QUEUE</name>
      <description>Queue manager</description>
      <baseAddress>0x00300000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x304</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MIRROR</name>
          <description>Source ports and the single monitor port of port mirroring.</description>
          <addressOffset>0x300</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>PORT</name>
              <description>Monitor port number.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>EGR_PORTS%s</name>
              <description>Ports whose sent frames are copied to the monitor port. Each port has one bit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <dim>11</dim>
              <dimIncrement>1</dimIncrement>
              <dimIndex>0-10</dimIndex>
              <name>IGR_PORTS%s</name>
              <description>Ports whose received frames are copied to the monitor port. Each port has one bit.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SCHED</name>
      <description>Egress scheduler</description>
      <baseAddress>0x00340000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1602C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>PORT_SHAPE_SLOT</name>
          <description>Period at which every port shaper adds tokens to its bucket.</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>SLOT</name>
              <description>Slot length in units of eight core clock periods. SYS_CLK shows the core clock. The smallest allowed value is 80.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>11</dim>
          <dimIncrement>0x8</dimIncrement>
          <name>PORT_SHAPE_CTRL[%s]</name>
          <description>64-bit configuration of the single token bucket that limits what one port sends. Token arithmetic gives the conversion from bit rates. Index: port = 0 to 10.</description>
          <addressOffset>0x14000</addressOffset>
          <register>
            <name>W0</name>
            <description>Port egress shaper: bits 31 to 0. 64-bit configuration of the single token bucket that limits what one port sends. Token arithmetic gives the conversion from bit rates.</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>CIR</name>
                <description>Rate in tokens per time slot.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>18</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>CBS</name>
                <description>Burst size in tokens.</description>
                <bitOffset>18</bitOffset>
                <bitWidth>14</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>W1</name>
            <description>Port egress shaper: bits 63 to 32. 64-bit configuration of the single token bucket that limits what one port sends. Token arithmetic gives the conversion from bit rates.</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>UNIT</name>
                <description>Token scale. Every token value is multiplied by 4 to the power of UNIT.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PKT_MODE</name>
                <description>Shape packets. Value 0 shapes bytes.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EN</name>
                <description>Enables the shaper.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <register>
          <dim>11</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PORT_SHAPE_STAT[%s]</name>
          <description>Current token count of one port shaper. The bit layout is not known. Index: port = 0 to 10.</description>
          <addressOffset>0x16000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Layout not known.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>

        </register>
        <register>
          <dim>10</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>LED_PAR_MAP[%s]</name>
          <description>Chooses which LED each parallel LED pin of one port position shows. Index: port = 0 to 9.</description>
          <addressOffset>0x1D0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <dim>3</dim>

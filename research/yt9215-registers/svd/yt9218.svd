                <field>
                  <name>DPORT</name>
                  <description>Layer 4 destination port.</description>
                  <bitOffset>16</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_UDF</name>
              <description>ACL key slot, bits 31 to 0, layout for key types UDF0, UDF1, UDF2, UDF3, UDF4, UDF5, UDF6, UDF7: User-defined fields</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>UDF1</name>
                  <description>Two bytes from the odd-numbered user-defined field window of the pair.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>UDF0</name>
                  <description>Two bytes from the even-numbered user-defined field window of the pair.</description>
                  <bitOffset>16</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W0_ETHERTYPE</name>
              <description>ACL key slot, bits 31 to 0, layout for key types ETHERTYPE: EtherType</description>
              <alternateRegister>W0</alternateRegister>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>ETHERTYPE</name>
                  <description>EtherType.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>16</bitWidth>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>W1</name>
              <description>ACL key slot: bits 63 to 32. Value half of one key slot. Index blk is the block and bin the slot in the block. The layout of bits 35 to 0 and of the range flags depends on ACL_KEY.TYPE.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <fields>
                <field>
                  <name>TYPE</name>
                  <description>Key type. It selects the layout of the rest of the slot.</description>
                  <bitOffset>4</bitOffset>
                  <bitWidth>5</bitWidth>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NA</name>
                      <description>Slot not used</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
